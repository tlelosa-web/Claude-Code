# ai-outreach-agency — environment variables
# Copy to .env and fill in real values. Never commit .env.

OPENROUTER_API_KEY=sk-or-replace-me
APIFY_API_KEY=apify_api_replace-me
GMAIL_CREDENTIALS_PATH=credentials.json
DB_PATH=outreach.db
SENDER_NAME=Tebello Lelosa
SENDER_TITLE=AI Automation Consultant
SENDER_EMAIL=tlelosa@gmail.com
DEFAULT_ASSET_TYPE=INSIGHT_DOC
EXPORTS_DIR=exports

# Local Ollama inference (research summariser — see ADR-004). Not secrets;
# these are safe local defaults. Requires the Ollama daemon running and
# qwen3:8b pulled (`ollama pull qwen3:8b`) for a real, non-offline run.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Rate limits (requests per minute). Defaults are conservative; raise if your
# plan/quota allows more.
OPENROUTER_RATE_LIMIT_PER_MIN=60
APIFY_RATE_LIMIT_PER_MIN=30
GMAIL_RATE_LIMIT_PER_MIN=20
OLLAMA_RATE_LIMIT_PER_MIN=120
