# TebelloReborn (Career Engine) — environment variables
# Copy to .env and fill in real values. Never commit .env.

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
APIFY_API_KEY=apify_api_replace-me
DB_PATH=career.db
OFFLINE_MODE=false
EXPORTS_DIR=exports

# Rate limits (requests per minute). Defaults are conservative; raise if your
# plan/quota allows more. OLLAMA_RATE_LIMIT_PER_MIN is a safety valve against
# a runaway loop, not a real throttle — Ollama serialises generation locally.
OLLAMA_RATE_LIMIT_PER_MIN=120
APIFY_RATE_LIMIT_PER_MIN=30
