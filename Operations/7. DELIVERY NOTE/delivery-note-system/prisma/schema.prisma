generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model DeliveryNote {
  id          String   @id @default(cuid())
  dnNumber    String   @unique
  date        DateTime
  customer    String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
