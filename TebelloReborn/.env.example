# TebelloReborn (Career Engine) — environment variables
# Copy to .env and fill in real values. Never commit .env.

OPENROUTER_API_KEY=sk-or-replace-me
APIFY_API_KEY=apify_api_replace-me
DB_PATH=career.db
OFFLINE_MODE=false
EXPORTS_DIR=exports

# Rate limits (requests per minute). Defaults are conservative; raise if your
# plan/quota allows more.
OPENROUTER_RATE_LIMIT_PER_MIN=60
APIFY_RATE_LIMIT_PER_MIN=30
