# Secrets — never commit real values
.env

# Generated SQLite database (source of truth lives in data/, not this)
*.db
*.db-shm
*.db-wal

# Python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Generated PDF exports — data/ itself stays tracked, this is output only
exports/

